# Host folder on your Mac/PC where uploaded files and project data are stored.
# Examples:
#   Mac: /Users/yourname/NutriProof/uploads
#   Windows: C:/NutriProof/uploads
#   Linux: /srv/nutriproof/uploads
UPLOAD_ROOT=./uploads
STORAGE_MODE=local
# Used only when STORAGE_MODE=gcs
# GCS_BUCKET=your-nutriproof-bucket
# GCS_PREFIX=uploads
PORT=8080
